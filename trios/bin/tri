      import("/Users/playra/BrowserOS/trios/.trinity/loop/channel.mjs").then(async (CH) => {
        const probe = [
          "echo PID1 $(cat /proc/1/comm)",
          "echo PIDS $(cat /sys/fs/cgroup/pids.current)/$(cat /sys/fs/cgroup/pids.max)",
          "z=0; tot=0; for d in /proc/[0-9]*; do s=$(awk \"{print \\$3}\" \"$d/stat\" 2>/dev/null) || continue; tot=$((tot+1)); [ \"$s\" = Z ] && z=$((z+1)); done",
          "echo PROCS $tot ZOMBIES $z",
        ].join("; ")
        try { console.log(CH.remote(probe, { attempts: 2 })) }
        catch (e) { console.log("could not reach the container:", String(e.message).slice(0, 140)) }
      })'
