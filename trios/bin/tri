try:
    d=json.load(sys.stdin)["bikes"]; print(sum(1 for b in d if b.get("image_url")), "/", len(d))
except Exception as e: print("ERR", e)'
    echo -n "InvalidToken: "; railway logs -s turbobaby-bot --lines 50 2>/dev/null | grep -ci InvalidToken
    echo "tb-deploy: готово"
    ;;

  tb-lint)
    # Оба clippy-гейта CI локально, до пуша: wasm и backend, -D warnings.
    # Вызов: tri tb-lint [--test]  (--test добавляет cargo test --features backend)
    cd "$HOME/turbobaby-user-bot" || exit 1
    rc=0
    echo "== wasm gate: cargo clippy --target wasm32-unknown-unknown =="
    cargo clippy --lib --target wasm32-unknown-unknown -- -D warnings || rc=1
    echo "== backend gate: cargo clippy --bin turbobaby-bot-server =="
    cargo clippy --features backend --bin turbobaby-bot-server -- -D warnings || rc=1
    if [ "$2" = "--test" ]; then
      echo "== tests: cargo test --features backend =="
      cargo test --features backend || rc=1
    fi
    [ "$rc" -eq 0 ] && echo "tb-lint: OK" || echo "tb-lint: FAIL"
    exit $rc
    ;;

  tb-verify)
    # Инварианты разделения: vars на месте, базы не перепутаны, чужой сервис жив.
    echo "== vars turbobaby-bot (mask) =="
    railway link -p woody -e production -s turbobaby-bot >/dev/null 2>&1
    railway variables --kv 2>/dev/null | grep -E "^(BOT_TOKEN|DATABASE_URL)=" | sed -E "s/^(BOT_TOKEN=.{8}).*/\1…/; s#(postgresql://[^:]+:)[^@]+@#\1***@#"
    echo "== миграции (woody=84 ours, woody_client=76 theirs) =="
    PGURL=$(railway variables -s postgres --kv 2>/dev/null | grep "^DATABASE_PUBLIC_URL=" | cut -d= -f2-)
    if [ -n "$PGURL" ]; then
