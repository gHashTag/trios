    # ручными правками, и происходила регулярно только одна. Здесь этот порядок
    # сделан структурным - написать указатель без файла отсюда невозможно.
    #   tri learn --audit                     — что в индексе висит в пустоту
    #   tri learn <slug> --hook "строка" --desc "..." --body-file F [--type T]
