    # (/health, /mcp) он не нужен.
    #   tri deploy-wait <путь> <маркер> [попыток]
    RENDER="https://vibee-render-production.up.railway.app"
    PATHQ="${2:-/health}"; MARK="${3:-}"; TRIES="${4:-40}"
    K=$(railway variables list -s vibee-render -e production --kv 2>/dev/null | grep '^RENDER_API_KEY=' | cut -d= -f2-)
    for i in $(seq 1 "$TRIES"); do
      body=$(curl -s -m 15 -H "X-Api-Key: $K" "$RENDER$PATHQ" 2>/dev/null)
      if [ -z "$MARK" ] || printf '%s' "$body" | grep -qF "$MARK"; then
        echo "✅ живой [$i]: $PATHQ → $(printf '%s' "$body" | head -c 140)"; exit 0
      fi
      echo "⏳ [$i/$TRIES] $PATHQ ещё без «$MARK»: $(printf '%s' "$body" | head -c 80)"
      sleep 30
    done
    echo "❌ ТАЙМАУТ: «$MARK» не появился на $PATHQ за $TRIES попыток"; exit 1
    ;;
  # ---- job campaign (added 2026-08-28) -------------------------------------
  # Everything below reads the mailbox and the CRM derived from it. None of it
  # sends: sending is a deliberate act with a human in the loop.
  jobs)
    exec python3 "$HOME/job-search/crm/loop.py" status
    ;;
  jobs-run)
    # One loop iteration. Refuses if any guard cannot prove itself first.
    exec python3 "$HOME/job-search/crm/loop.py" run
    ;;
  jobs-guards)
    # The gate in front of every outbound letter. Exit 1 means do not send.
    exec python3 "$HOME/job-search/crm/loop.py" preflight
    ;;
  jobs-anomalies)
    exec python3 "$HOME/job-search/crm/loop.py" anomalies
    ;;
  jobs-journal)
    exec python3 "$HOME/job-search/crm/loop.py" journal "${2:-10}"
    ;;
  jobs-next)
    exec python3 "$HOME/job-search/crm/jcrm.py" next
    ;;
  jobs-owed)
    exec python3 "$HOME/job-search/crm/jcrm.py" owed
    ;;
  jobs-board)
    exec python3 "$HOME/job-search/crm/jcrm.py" board
    ;;
  jobs-show)
    [ -z "${2:-}" ] && { echo "tri jobs-show <кто>"; exit 1; }
    exec python3 "$HOME/job-search/crm/jcrm.py" show "$2"
    ;;
  jobs-dash)
    python3 "$HOME/job-search/crm/jcrm.py" sync > /dev/null || exit 1
    python3 "$HOME/job-search/crm/jcrm.py" dashboard || exit 1
    # The trailing test used to BE the exit status, so a successful rebuild
    # without "open" reported failure and broke every `tri jobs-dash && ...`.
    if [ "${2:-}" = "open" ]; then open "$HOME/job-search/crm/dashboard.html"; fi
    exit 0
    ;;
  jobs-check)
    # Four guards over one draft, in the order that matters: leakage, truth,
    # duplicate signature, then voice. Any non-zero and the letter does not go.
    [ -z "${2:-}" ] && { echo "tri jobs-check <draft.md>"; exit 1; }
    python3 "$HOME/skills/_state/bin/letter_extract.py" "$2" > /dev/null || { echo "letter_extract: REFUSED"; python3 "$HOME/skills/_state/bin/letter_extract.py" "$2"; exit 1; }
    python3 "$HOME/skills/_state/bin/letter_extract.py" "$2" | tail -n +2 > /tmp/tri-body.$$
    python3 "$HOME/skills/claim-guard/scripts/claim_guard.py" /tmp/tri-body.$$ || { rm -f /tmp/tri-body.$$; exit 1; }
    rm -f /tmp/tri-body.$$
    python3 "$HOME/skills/business-voice/scripts/signature_guard.py" "$2" || exit 1
    exec python3 "$HOME/skills/business-voice/scripts/tone_check.py" "$2"
    ;;
  jobs-lesson)
    # Append a lesson to the skill that will be loaded next time, not to a note
    # nobody opens. Two arguments: heading and body.
    [ -z "${3:-}" ] && { echo 'tri jobs-lesson "заголовок" "текст"'; exit 1; }
    f="$HOME/skills/correspondence-crm/LESSONS.md"
    { echo; echo "## $(date '+%Y-%m-%d %H:%M') — $2"; echo; echo "$3"; } >> "$f"
    echo "записано в $f"
    ;;
  jobs-drafts)
    # Каждый черновик в один из: отправлен почтой, отправлен через hh,
    # без адресата (портал), ждёт отправки. Actionable — только последний.
    exec python3 "$HOME/job-search/crm/drafts.py" "${2:-report}"
    ;;
  jobs-leads)
    # Потенциальные заказчики по теме, а не вакансии. Тиры по наличию связи.
    exec python3 "$HOME/job-search/crm/leads.py" "${2:-all}"
    ;;
  # ---- telegram, read-only ---------------------------------------------
  tg-dialogs)   exec tg dialogs -n "${2:-25}" ;;
  tg-unread)    exec tg unread ;;
  tg-msg)       [ -z "${2:-}" ] && { echo "tri tg-msg <chat|@user> [N]"; exit 1; }
                exec tg messages "$2" -n "${3:-25}" ;;
  tg-search)    [ -z "${2:-}" ] && { echo "tri tg-search <текст> [N]"; exit 1; }
                exec tg search "$2" -n "${3:-25}" ;;
  tg-who)       exec tg whoami ;;
  help|-h|--help)
    cat <<'USAGE'
tri — Trinity S³AI ops CLI
  tri (или tri ssh) — railway ssh → claude (прежнее поведение)
  tri status       — здоровье стека + лента + состояние лупа
  tri regress      — регресс-чек лупа (15 проверок)
  tri morning      — утренняя сводка loop/MORNING.md
  tri loop         — хвост отчёта цикла
  tri vibee-feed [N] — последние N постов ленты vibee со звёздами/просмотрами
                     (ПЕРЕИМЕНОВАНА 2026-09-05: прежнее её имя носит теперь шаг
                     заправки цикла — строка с `--act` ниже, это другая команда)
  tri chat "текст" — вопрос агенту (ключ тянется из Railway сам)
  tri selftest     — проверка зависимостей
  tri anomalies (то же самое — tri anom) — шаг 0: что сломалось на проде (провайдеры, лента, маршруты)
  tri verify       — не затёрта ли прошлая правка чужим мержем
  tri providers (то же самое — tri prov) — живой статус провайдеров (чем агент может работать)
  tri lesson "H" "B" — быстро записать урок в loop-opus/LESSONS.md
  tri dash         — пересобрать продакшн-дашборд STATUS.md
  tri board        — дашборд trios: последняя итерация + замеры STATUS.md
  tri wave         — каркас следующей волны wave-loop-NNN.md
  tri wave-plan [N] — план ТЕКУЩЕЙ волны целиком (самый свежий wave-loop-*.md) с возрастом
  tri handover     — сводка владельцу из самой свежей волны: начало + варианты + возраст
  tri handover-116-archived — замороженный брифинг волны 116 (архив, не текущее состояние)
  tri locks        — кто держит локи кассет/e2e триоса сейчас
  tri next         — хвост последней волны trios. МЕРА 2026-09-13: печатает его
                     на 44 волнах из 78 — его образец ищет только английский
                     заголовок, а 15 волн (включая последнюю) назвали хвост
                     по-русски, и на них команда печатает одно имя файла.
                     сам хвост оттуда сейчас печатает команда handover ниже
  tri mutants-logic-refresh [DRY=1] — пересобрать .trinity/build/QueenCore дефолтным
                     тулчейном и прогнать make mutants-logic (рассинхрон тулчейнов)
  tri deploy-wait (то же самое — tri live-wait) <путь> <маркер> [N] — ждать, пока правка доедет до живого render
  tri tb            — TurboBaby: сводка прода + разделения с woody-weed-bot
  tri tb-deploy     — безопасный деплой turbobaby-bot (link→up→wait→verify)
  tri tb-verify     — инварианты разделения: vars/миграции/чужой health
  tri tb-lint       — оба clippy-гейта CI локально (+ --test для cargo test)
  tri live-verify [issue] [crit] — живой отпечаток цепочкой за один запуск
  tri regression [issue] [crit] — доска + локи + live-verify одной командой
  tri spec-diag [log] — класс ошибки каждой несобирающейся спеки
  tri jobs         — статус кампании одной строкой (guards/urgent/итерации)
  tri jobs-run     — одна итерация цикла: preflight → sync → аномалии → дашборд
  tri jobs-guards  — доказать guard'ы перед отправкой (exit 1 = не отправлять)
  tri jobs-next    — что делать дальше, по убыванию отдачи
  tri jobs-owed    — кто ждёт ответа, старейший долг первым
  tri jobs-board   — воронка по стадиям
  tri jobs-show X  — одна переписка целиком, обе стороны
  tri jobs-dash [open] — пересобрать дашборд (и открыть)
  tri jobs-check F — четыре guard'а: утечки, правда, дубль подписи, голос
  tri jobs-anomalies / jobs-journal [N] — что не так / история итераций
  tri jobs-drafts [report|actionable] — разбор черновиков: что ушло, что ждёт
  tri jobs-leads [new|channels] — заказчики по теме: кому есть смысл писать
  tri jobs-lesson "H" "B" — записать урок в correspondence-crm/LESSONS.md
  tri tg-unread / tg-dialogs [N] — телеграм: непрочитанные / чаты (только чтение)
  tri tg-msg <чат> [N] / tg-search <текст> [N] / tg-who
  tri game            — луп игры t27.ai/#/queen: состояние (итерация, задачи, находки)
  tri game-claim / game-release — замок цикла (exit 75 = другой прогон держит)
  tri game-iterate    — новый цикл: счётчик + last_run
  tri game-anomalies [--heal] — живые проверки: эндпоинты, апекс vs main, публикатор, чанк; --heal чинит
  tri game-next       — верхняя открытая задача бэклога
  tri game-task ID [--title|--status|--note|--force] / game-finding "T" [--severity] / game-gate ID [--result]
  tri game-dash [open] — DASHBOARD.md + dashboard.html (дизайн Claude Code); последним в цикле
  tri game-report [N] — последний отчёт цикла (первые N строк)
  tri game-ingest J [--cycle N] — влить план воркфлоу из journal.jsonl в бэклог (идемпотентно)
  tri game-lesson "H" "B" — записать урок в queen-game-loop/LESSONS.md
  tri game-wire [board|status|hardware|activity|research] — что реально несут публичные эндпоинты (поля на N карточках)
  tri game-prove MARKER | --entry index-X.js | --apex [--after index-OLD.js] [--minutes 9] — ждать, пока t27.ai отдаст Queen-чанк с маркером / названный entry / entry из apex index.html (отличный от --after); exit 0 = доказано
  tri game-gates [fast|full] [LOG] — цепочка гейтов Queen (full = + 5 headless-Chrome контрактов, ~8 мин); exit 0 = все зелёные
  tri game-ship BRANCH TITLE MSGFILE BODYFILE -- PATHSPEC... — add по pathspec, commit, push, PR, squash-merge, dispatch паблишера (без watch и без prove)
  tri game-close TASK_ID "msg" — закрытие цикла: task done, аномалии --heal, closed_at, iterate, dash, release, коммит скилла (отчёт и CONTEXT.md правятся руками ДО)
  tri game-spike [--no-build] — замер движков на текущем checkout: canvas2D vs Babylon, rAF p50/p95/p99, пропуски vsync, brotli чанков (GPU через ANGLE/Metal)
  tri game-local [--build|--stop] — «запусти локально»: vite preview собранного сайта на 127.0.0.1:4173 и открыть #/queen в браузере по умолчанию (не в панели приложения: там страница скрыта и движок стоит)
  tri game-models [list|pull <slug>] — модели поля (public/queen/models) с размерами и лицензией; pull тянет пак Kenney по slug только после слова пользователя, печатая источник и размер
  tri game-objects [--json] — учёт объектов поля: что нарисовано, на каком слое и какая сущность за этим стоит
  tri game-foundation [--out PATH] [--repo R] [--limit N] — снимок GitHub для фундамента (закрытые задачи, эпики с детьми и кольцом, релизы, кольца) в public/queen/foundation.json; пишет только при изменении содержимого без generatedAt, иначе печатает unchanged
  tri game-plan [путь] — план здания модуля из modules.json той же чистой функцией, что рисует поле (ядро, масштаб, высота, крылья, антенны, поворот, хеш)
  tri game-verify     — самопроверка состояния лупа игры: дубли id, неизвестные статусы и severity, протухший замок (выход 1 = состояние противоречиво)
  tri game-status [API] — что читают статус-пилюля и плитка VERDICTS: swarmState, планировщик, диспатчи (running/unreviewed), решение последнего тика
  tri game-round [API] — тикает ли Королева: lastRoundAt и roundSeconds против ЧАСОВ СЕРВЕРА (заголовок Date), не против ноутбука
  tri game-clock [API] — отдаёт ли статус-эндпоинт свои часы браузеру на t27.ai (Date, Access-Control-Expose-Headers) и каков сдвиг с этой машиной
  tri game-bees [API] — живые пчёлы с public-board и возраст последнего слова каждой на проводе активности против длины раунда (warm/COLD)
  tri game-events [KIND] [HOURS] [API] — свежие события одного вида на проводе активности с их состоянием, словами INTEL FEED (по умолчанию review)
  tri game-feed [HOURS] [API] — что заголовок INTEL FEED должен сказать о свежем ответе провода: строк, размах между старейшей и новейшей, виды
  tri game-activity [HOURS] [API] — выборка /queen/public-activity за N часов: виды, вердикты ревью по (issue, state) со всеми штампами, свежий тик
  tri game-measure NAME [--build] — прогнать ОДИН headless-контракт qa/queen-NAME-contract.mjs на текущем dist (отказ, пока идёт цепочка гейтов: dist общий)
  tri game-contract NAME "что доказывает" — завести qa/queen-NAME-contract.mjs из pick-харнесса, зарегистрировать check:queen-NAME и дописать в полный список гейтов (хвост падает НАРОЧНО)
  tri game-bar        — ширины колонок ресурсной полосы на четырёх десктопных размерах в обоих языках (замер, нашедший бренд-надбровие на 200 px)
  tri game-copy KEY [KEY...] — английское и русское значение COPY-ключа из Queen.tsx и сколько мест его используют
  tri game-branch NAME — первое действие цикла: fetch origin и ветка NAME от origin/main в checkout trinity (отказ, если в дереве чужие правки)
  --- continuous loop (trios) ---
  tri iter / iter-dash / iter-log [N] / iter-anchors — состояние цикла, дашборд, журнал
  tri iter-render [--work f.json] — замерить рой, обновить опоры, перерисовать дашборд
  tri iter-unlock — снять замок цикла (только если `tri iter` говорит stale)
  tri swarm — живое состояние Королевы одной строкой
  tri fence — какие пути держат застрявшие задания (границы, которых избегать)
  tri brief-gate <draft.md ...> — проверить черновик задачи парсером самой Королевы
  tri facts [--record|--facts]    — измеренные числа дашборда; неизмеримое показывается как '-'
  tri failures [--since N|<step>] — какие шаги цепочки падают, как часто и с какими уликами
  tri channel                     — жив ли единственный канал в контейнер
  tri share-modules [--share]     — одна установка зависимостей, связанная ссылками во все деревья
  tri reap-finished [--reap]      — убрать деревья, чья работа уже опубликована (по сроку жизни, не по давлению)
  tri rescue [--rescue]           — спасти работу, которую пчела не закоммитила, пока её не стёрли
  tri container                   — кто PID 1 и близко ли к исчерпанию процессов
  tri two-views [--record|--report] — согласны ли /health и ssh-шлюз в один момент
  tri salvage <N> [--brief]       — что уцелело от устаревшей ветки: имена, которых нет в базе; --brief пишет задание
  tri proven [--by-source]        — доказывает ли свежая работа что-нибудь; --by-source: разрез по виду работы
  tri coverage [--fresh]          — какую долю принятых вердиктов аудит может проверить (кэш: 10с против 217с)
  tri verdict-audit <N ...> | --accepted — сверить заявленный вердикт пчелы с её диффом
  tri boundary <N ...>            — что пчеле разрешили трогать и что она тронула; CREATED против edited
  tri t27-gen                     — перегенерировать кольцо T27-00 из .t27 (артефакт не правят руками)
  tri t27-parity                  — согласны ли сгенерированное кольцо и рукописный близнец из продакшена
  tri forked-files                — файл, который лежит в двух местах, не должен начать говорить разное
  tri ci-diff <run|--pr a b>      — какие падения в CI НОВЫЕ, а какие были красными до тебя
  tri exposure                    — что живой сервис отдаёт origin'у, которого он не знает
  tri flaky [N|<run-id>...]       — какие красные тесты падают ВСЕГДА, а какие через раз
  tri accept-rate                 — принимают ли реже бриф, который МОЖНО провалить
  tri unverdicted [--limit N]     — диспатчи без блока VERDICT: ревью их никогда не рассудит
  tri silent-loop [--limit N]     — попытки, которые не тратят лимит повторов: у цикла нет потолка
  tri rejudge [--state S]         — вердикт, который текущий код уже не повторит (согласие ≠ правота)
  tri agree [--pair NAME]         — два кода одного правила на реальных строках: где расходятся и куда
  tri idle [--hours N]            — сколько рой простоял и что помешало раундам (золотое правило)
  tri unwired [--all]             — гейт, который написан, но его никто не запускает
  tri reach [--since D] [--floor N] — какой шаг цепочки heal ДОХОДИТ до запуска, а какой всегда последний
  tri reap [--reap] — сборка worktree по порогам 80/60, без --force
  tri lease [--release] — аренда заявки с таймером простоя, потолок повторов 2
  tri heal [--dry] — все ремонты роя одной цепочкой в верном порядке
  tri author [--file] — завести задачу из измеренного дефицита, лимит 5 открытых
  tri loop-selftest — поверка собственных приборов цикла (без сети; счётчик печатает сам прогон, а не эта строка)
  tri judge-packet <N ...> | --unauditable — собрать пакет для судейского прочтения
  tri needs-you [--all] — что ждёт человека и сколько уже ждёт
  tri loop-coverage — у каких инструментов цикла боевая ветка ни разу не исполнялась
  tri trend [часов] — скорость счётчиков, а не их уровень
  tri clocks — на каких полях висят решения и не переписывает ли их кто-то
  tri fields [файл] — читает ли код поля, которых запрос не выбирает
  tri fp-check [N] — не обвиняют ли проверяльщики заведомо годное
  tri push-work [--push] — отправить ветки пчёл, которых нет на удалённом
  tri close-done [--close] — закрыть задачи с принятой работой (эпики не трогает)
  tri unpark [--release] — снять потолок повторов, потраченный на молчание, а не на работу
  tri stale-escalations [--release] — отпустить эскалацию, чья причина больше не воспроизводится
  tri holds — что рой держит сейчас и не заявлены ли два диспатча на один файл
  tri queue — глубина очереди (не число открытых): что ещё никто не начинал
  tri latency — куда уходит время: ревью против работы пчелы, и сколько задач в час
  tri reap-local [--reap] — убрать слитые и чистые рабочие деревья с диска ноутбука
  tri verdicts [часов] — доля принятого, возвращённого и неосуждённого: здоровье, а не загрузка
  tri why [--all] — почему рой стоит: причина, улика и что с этим делать
  tri feed [--act] — только заправка: пуш, закрытие, заведение, без аудитов
  tri mix — каким ВИДОМ работы занят рой: загрузка и приёмка этого не покажут
  tri land [--land] — посадить принятую работу, что осталась на ветках вне базы
  tri ab <a> <nA> <b> <nB> — отличается ли разница от шума, или это просто мало данных
  --- cycle: измерить, перекрестно допросить, нарисовать, записать ---
  tri cycle [--deep] — один проход: замер, аномалии, дашборд, запись в журнал (выход 2 = аномалии найдены, это ответ)
  tri cycle-repair — то же плюс перечисленные безопасные ремонты (замок мёртвого хозяина, ЧИСТЫЕ деревья)
  tri cycle-dash — показать последний дашборд, и первой строкой его возраст с файловой системы
  tri cycle-html — тот же замер, но широкий: у каждой цифры видна команда, которой её измерили, и рядом с каждой аномалией её ремонт. Выход 2, если замеру больше одного цикла
  tri cycle-anom [N] (то же самое — tri cycle-anomalies) — каждая аномалия целиком: заявление, правда, ремонт (на дашборде помещается семь)
  tri cycle-sense [--deep] — только замер, без рисования
  tri cycle-log [N] — журнал проходов: сколько аномалий, какие витали, что чинили
  tri cycle-note did|next "текст" — проза пишется руками; дашборд рисует пустоту, если её не написали
  tri cycle-doctor — на месте ли всё, что циклу нужно, и достижима ли каждая его команда
  tri driver — крутит ли итерации хоть кто-нибудь. Выход 1 — водителя нет (измеренный ноль), 2 — прочитать не удалось (это НЕ ноль)
  tri drift [--adopt] — тот ли это файл, что крутят таймеры, и лежит ли он в репозитории
                     (выход 1 — измеренное расхождение, 2 — прочитать не удалось; --adopt только руками)
  tri backlog — что бэклог СОДЕРЖИТ, прочитанный по задаче, а не выведенный из счётчиков пропусков
  --- опыт и навыки ---
  tri learn --audit — сколько указателей индекса памяти ведёт в файл, которого нет
  tri learn <slug> --hook "..." --desc "..." --body-file F [--type feedback] — сохранить опыт: сперва файл, потом указатель
  tri skills [фильтр] — какие навыки лежат на диске и у каких нет своего SKILL.md
  tri proof <файл.md> ...  — существует ли то, на что документ ссылается (выход 2, если нет)
  tri loop-lesson "текст" — записать урок ЦИКЛА в state.json и ledger.jsonl одной командой,
                     в момент находки (не путать с командой `lesson` выше: та пишет в loop-opus/LESSONS.md)
  tri lesson-orphans [--all] — какие уроки из state.json не дошли НИ ДО ОДНОГО навыка
                     дерева trios (--all: плюс оба домашних каталога навыков; какие
                     именно корни прочитаны, команда печатает сама); выход 2 = сироты
  --- приборы цикла, у которых до 2026-09-13 не было точки входа ---
  tri which-board [--json|--no-gh|--selftest] — какую доску GitHub читает каждый прибор цикла
                     и движется ли она; выход 2 = набор приборов расколот (команда `board` выше — другое: дашборд trios)
  tri judge-calibration --build [N] | --score FILE | --report — померить СУДЬЮ на вопросах,
                     ответ на которые арифметика; выход 2 = судья подтвердил фантом
  tri dash2 [--write] [--reading F] [--no-color] — дашборд цикла СВЕЖИМ замером: живость двумя
                     сигналами, у каждого числа возраст, неизмеренное как '-' (уже нарисованный показывает `cycle-dash`)
  tri help (то же самое — tri -h, tri --help) — эта справка
USAGE
