        echo -n "$db: "
        psql "${PGURL%/*}/$db" -t -A -c "SELECT count(*) FROM _schema_migrations" 2>/dev/null || echo "ERR"
      done
    else
      echo "нет DATABASE_PUBLIC_URL у postgres — пропуск"
    fi
    echo "== чужой сервис (только /health) =="
    echo -n "woody-weed-bot: "; curl -s -m 8 -o /dev/null -w "%{http_code}\n" https://woody-weed-bot-production-370f.up.railway.app/health
    ;;

  *)
    echo "неизвестная команда: $1 (tri help)"; exit 1
    ;;
