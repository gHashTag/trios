    python3 - "$@" << 'PYLEARN'
import os, re, sys

MEM = "/Users/playra/.claude/projects/-Users-playra-BrowserOS/memory"
IDX = os.path.join(MEM, "MEMORY.md")
KINDS = ("user", "feedback", "project", "reference")
POINTER = re.compile(r"\]\(([a-z0-9][a-z0-9-]*\.md)\)")


def pointers():
    if not os.path.exists(IDX):
        return []
    out = []
    for n, line in enumerate(open(IDX, encoding="utf-8"), 1):
        m = POINTER.search(line)
        if m:
            out.append((n, m.group(1), line.rstrip("\n")))
    return out


def audit():
    pts = pointers()
    dead = [(n, t) for n, t, _ in pts if not os.path.exists(os.path.join(MEM, t))]
    on_disk = set(
        f for f in os.listdir(MEM) if f.endswith(".md") and f != "MEMORY.md"
    )
    indexed = set(t for _, t, _ in pts)
    # A file reached only through a [[link]] in another memory is indexed enough.
    linked = set()
    for f in on_disk:
        body = open(os.path.join(MEM, f), encoding="utf-8", errors="replace").read()
        for name in re.findall(r"\[\[([a-z0-9][a-z0-9-]*)\]\]", body):
            linked.add(name + ".md")
    orphan = sorted(on_disk - indexed - linked)
    print("pointers in MEMORY.md   : %d" % len(pts))
    print("resolve to a real file  : %d" % (len(pts) - len(dead)))
    print("dangling                : %d" % len(dead))
    print("files on disk           : %d" % len(on_disk))
    print("on disk, unreachable    : %d" % len(orphan))
    for n, t in dead:
        print("  dangling  MEMORY.md:%-4d %s" % (n, t))
    for f in orphan:
        print("  unreachable          %s" % f)
    if not dead and not orphan:
        print("\nindex and disk agree")
        return 0
    print(
        "\nA dangling pointer is not harmless: the one line of prose after the dash"
        "\nis then the whole memory, while the link advertises a document behind it."
    )
    return 2


args = sys.argv[1:]
if not args or args[0] in ("-h", "--help"):
    print('tri learn --audit')
    print('tri learn <slug> --hook "строка индекса" --desc "..." --body-file F [--type feedback]')
    sys.exit(1)
if args[0] == "--audit":
    sys.exit(audit())

slug = args[0]
opt = {}
i = 1
while i < len(args):
    if args[i].startswith("--") and i + 1 < len(args):
        opt[args[i][2:]] = args[i + 1]
        i += 2
    else:
        sys.exit("не понял аргумент: %s" % args[i])

if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug):
    sys.exit("slug должен быть kebab-case ascii: %s" % slug)
kind = opt.get("type", "project")
if kind not in KINDS:
    sys.exit("--type должен быть одним из: %s" % ", ".join(KINDS))
for need in ("hook", "desc"):
    if not opt.get(need):
        sys.exit("--%s обязателен: индекс без него нечитаем" % need)
bf = opt.get("body-file")
if not bf:
    sys.exit("--body-file обязателен: тело памяти пишется, а не генерируется")
if not os.path.exists(bf):
    sys.exit("нет такого файла: %s" % bf)
body = open(bf, encoding="utf-8").read().strip()
if not body:
    sys.exit("тело пустое: %s" % bf)

path = os.path.join(MEM, slug + ".md")
existed = os.path.exists(path)
desc = opt["desc"].replace('"', "'")
with open(path, "w", encoding="utf-8") as fh:
    fh.write("---\nname: %s\ndescription: \"%s\"\nmetadata:\n  type: %s\n---\n\n%s\n"
             % (slug, desc, kind, body))

# Только теперь - указатель. И только если его ещё нет.
line = "- [%s](%s.md) — %s" % (opt.get("title", slug), slug, opt["hook"])
have = [t for _, t, _ in pointers()]
if slug + ".md" in have:
    print("%s: %s" % ("переписан" if existed else "создан", path))
    print("указатель уже был в MEMORY.md, не дублирую")
else:
    with open(IDX, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")
    print("создан: %s" % path)
    print("в индекс: %s" % line)
PYLEARN
    ;;
  skills)
    # Что лежит на диске как навык - и у каких навыков нет собственного
    # SKILL.md, то есть имя каталога есть, а инструкции нет. Это НЕ ответ на
    # вопрос "какие навыки видит Королева": её доступность меряется на проводе,
    # а не в файловой системе (WAVE-066: она доставала 4 из 26).
    python3 - "${2:-}" << 'PYSKILLS'
import os, sys

ROOTS = [
    ("проект  ", "/Users/playra/BrowserOS/trios/.claude/skills"),
    ("личные  ", os.path.expanduser("~/.claude/skills")),
    ("библиотека", os.path.expanduser("~/skills")),
]
want = (sys.argv[1] if len(sys.argv) > 1 else "").strip()
total = broken = 0
for label, root in ROOTS:
    if not os.path.isdir(root):
        print("%s  %s  — нет каталога" % (label, root))
        continue
    # `.git`, `_state`, `_archive` и прочая обвязка каталогом навыка не является.
    # Без этой строки команда в первом же запуске выдала 8 находок, из которых
    # настоящей была одна: инструмент, считающий шум находками, - тот самый
    # дефект, ради которого этот цикл и заведён.
    names = sorted(
        d
        for d in os.listdir(root)
        if os.path.isdir(os.path.join(root, d)) and not d.startswith((".", "_"))
    )
    print("\n%s  %s  (%d)" % (label, root, len(names)))
    for n in names:
        if want and want not in n:
            continue
        sk = os.path.join(root, n, "SKILL.md")
        total += 1
        if os.path.exists(sk):
            size = os.path.getsize(sk)
            head = ""
            for line in open(sk, encoding="utf-8", errors="replace"):
                if line.startswith("description:"):
                    head = line.split(":", 1)[1].strip().strip('"')[:70]
                    break
            print("  %-34s %6d b  %s" % (n, size, head))
        else:
            broken += 1
            print("  %-34s      -  НЕТ SKILL.md" % n)
print("\nвсего каталогов: %d, без SKILL.md: %d" % (total, broken))
sys.exit(2 if broken else 0)
PYSKILLS
    ;;
  proof)
    # Ссылается ли документ на то, что существует. claim-guard когда-то дал
    # зелёный свет на опечатку в имени файла: путь был процитирован, файла не
    # было, и никто не спросил диск. Здесь спрашивают диск.
    #   tri proof <файл.md> [...]      — выход 2, если хоть один путь не найден
    [ -z "${2:-}" ] && { echo 'tri proof <файл.md> [...]'; exit 1; }
    shift 2>/dev/null || true
    python3 - "$@" << 'PYPROOF'
import os, re, subprocess, sys

REPO = "/Users/playra/BrowserOS"
CODE = re.compile(r"`([^`\n]{2,160})`")
LOOKS_PATH = re.compile(r"^[~./A-Za-z0-9_-][A-Za-z0-9_./~*-]*$")
# Расширение, которое действительно бывает у файла этого дерева. Без этого
# списка `ProjectPaths.trinity` (обращение к свойству в Swift) читается как путь
# и попадает в отчёт ненайденным - обвинение, которого никто не делал.
EXTS = {
    ".md", ".mjs", ".js", ".ts", ".tsx", ".json", ".jsonl", ".swift", ".sh",
    ".py", ".rs", ".toml", ".yml", ".yaml", ".t27", ".zig", ".c", ".h", ".v",
    ".plist", ".txt", ".ansi", ".lock", ".app", ".png", ".svg", ".log", ".env",
}

# Путь в документе относителен не текущему каталогу, а чаще всего каталогу
# самого документа или корню дерева. 2026-07 отчёт объявил 15 мёртвых ссылок,
# и все 15 были живыми - их просто мерили не от того корня. Здесь спрашивают
# git: он знает настоящий набор путей.
try:
    tracked = set(
        subprocess.run(
            ["git", "-C", REPO, "ls-files"],
            capture_output=True, text=True, timeout=60, check=True,
        ).stdout.split("\n")
    ) - {""}
except Exception as e:
    print("git ls-files не ответил (%s) - проверяю только файловой системой" % e)
    tracked = set()
by_base = {}
for t in tracked:
    by_base.setdefault(os.path.basename(t), []).append(t)


def resolves(cand, docdir):
    exp = os.path.expanduser(cand)
    if os.path.isabs(exp):
        return os.path.exists(exp)
    roots = [docdir, REPO, os.getcwd()]
    # ...и каждый каталог между документом и корнем дерева.
    d = docdir
    while d.startswith(REPO) and d != REPO:
        d = os.path.dirname(d)
        roots.append(d)
    if any(os.path.exists(os.path.join(r, exp)) for r in roots):
        return True
    if cand in tracked or any(t.endswith("/" + cand) for t in tracked):
        return True
    if "/" not in cand and cand in by_base:
        return True
    if "*" in cand:                      # `.worktrees/*/trios` - проверяем ствол
        stem = cand.split("*")[0].rstrip("/")
        return bool(stem) and any(os.path.exists(os.path.join(r, stem)) for r in roots)
    return False


bad = checked = 0
for doc in sys.argv[1:]:
    if not os.path.exists(doc):
        print("НЕТ ДОКУМЕНТА  %s" % doc)
        bad += 1
        continue
    docdir = os.path.dirname(os.path.abspath(doc))
    text = open(doc, encoding="utf-8", errors="replace").read()
    seen, misses = set(), []
    for raw in CODE.findall(text):
        cand = raw.split(":")[0].strip().rstrip(".,;")
        if cand in seen or not LOOKS_PATH.match(cand):
            continue
        ext = os.path.splitext(cand)[1].lower()
        if "/" not in cand and ext not in EXTS:
            continue                     # одиночное слово - это не путь
        if "/" in cand and ext and ext not in EXTS and not cand.endswith("/"):
            pass                         # каталог с точкой в имени - всё же путь
        seen.add(cand)
        checked += 1
        if not resolves(cand, docdir):
            misses.append(cand)
    print("\n%s — путей %d, не найдено %d" % (doc, len(seen), len(misses)))
    for m in misses:
        print("  НЕ НАЙДЕН  %s" % m)
    bad += len(misses)
print("\nпроверено путей: %d, не найдено: %d" % (checked, bad))
print("(корни: каталог документа, каждый каталог до корня дерева, и git ls-files)")
sys.exit(2 if bad else 0)
PYPROOF
    ;;

  # --- инструменты цикла, у которых не было точки входа (2026-09-13) --------
  #
  # Аудит 2026-09-13 нашёл здесь два класса: инструмент, написанный и не
  # подключённый ни к одной руке (judge-calibration.mjs и dash2.mjs, 27 КБ на
  # двоих, ноль импортёров), и руку без строки в `tri help` (23 из 146). Обе
  # руки ниже добавлены ВМЕСТЕ со своими строками справки одним прогоном:
  # недокументированная рука — это и есть второй из этих двух дефектов.
  #
  # Имена сверены со всеми метками выше перед вставкой: `case` берёт ПЕРВОЕ
  # совпадение, и именно так `tri feed --act` всю свою жизнь попадал в чужую
  # руку. `board`, `lesson`, `status`, `wave` уже заняты и означают другое —
  # поэтому здесь `which-board`, `loop-lesson`, `wave-plan`.

  which-board)
    # КАКУЮ доску на GitHub читает каждый прибор цикла и движется ли она.
    # Имя не `board`: `tri board` (выше) рисует дашборд trios из
    # iterations.jsonl и STATUS.md — другой вопрос и другой источник.
    # Выход 2 = набор приборов расколот или читает доску, которая стоит,
    # пока работает другая. Это ответ, а не сбой.
    #   tri which-board [--json] [--no-gh] [--selftest]
    shift 2>/dev/null || true
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/board.mjs "$@"
    ;;
  judge-calibration)
    # Померить СУДЬЮ до того, как доверить ему работу, которую не достаёт ни
    # один механический чек. Вопросы строятся из кэша verdict-audit, ответ на
    # каждый — арифметика, а не мнение; ключ пишется в state/, а не в
    # packets/, чтобы судья не прочитал ответы. Выход 2 = судья подтвердил
    # фантом (находка о судье, не поломка прибора).
    #   tri judge-calibration --build [N] | --score FILE | --report
    shift 2>/dev/null || true
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/judge-calibration.mjs "$@"
    ;;
  dash2)
    # Дашборд цикла, нарисованный так, чтобы ОСТАНОВЛЕННЫЙ цикл не выглядел
    # работающим: живость — два независимых сигнала, у каждого числа есть
    # возраст, неизмеренное печатается как '-', а проза читается из
    # cycle-notes.json и никогда не генерируется.
    #   tri dash2 [--write] [--reading FILE] [--no-color]
    # `tri cycle-dash` показывает УЖЕ нарисованный DASHBOARD2.ansi с его
    # возрастом; здесь берётся свежий замер.
    shift 2>/dev/null || true
    exec node /Users/playra/BrowserOS/trios/.trinity/loop/dash2.mjs "$@"
    ;;
  loop-lesson)
    # Урок записывается В МОМЕНТ НАХОДКИ, одной командой, а не в конце сессии.
    # Пишет ровно туда, куда пишет сам цикл: state.json -> lessons[] плюс
    # строка в ledger.jsonl — через lesson() из loop.mjs, чтобы здесь не
    # завелась вторая реализация того же формата (две копии одного правила —
    # самый дорогой дефект этого дерева, см. `tri agree`).
    # ИМЯ НЕ `lesson`: `tri lesson` (выше) пишет в ДРУГОЕ дерево —
    # 999-multibots-telegraf/.claude/loop-opus/LESSONS.md.
    #   tri loop-lesson "что выяснилось — одним абзацем"
    shift 2>/dev/null || true
    TEXT="$*"
    [ -z "$TEXT" ] && { echo 'tri loop-lesson "что выяснилось — одним абзацем"'; exit 1; }
    TRI_LESSON_TEXT="$TEXT" node --input-type=module -e '
      const m = await import("/Users/playra/BrowserOS/trios/.trinity/loop/loop.mjs")
      const text = process.env.TRI_LESSON_TEXT
      m.lesson(text)
      const s = m.loadState()
      const last = s.lessons[s.lessons.length - 1]
      console.log("lesson " + s.lessons.length + " recorded, iteration " + last.iteration + ", " + last.at)
      console.log(last.text)
      console.log("(state.json + ledger.jsonl; sanity: tri lesson-orphans)")
    '
    ;;
  lesson-orphans)
    # Какие уроки цикла не дошли НИ ДО ОДНОГО навыка. Урок живёт в
    # state.json и читается только тем, кто откроет state.json; навык
    # загружается сам. 2026-09-13 замер нашёл семь таких уроков.
    #
    # ЧТО ИМЕННО ИЗМЕРЯЕТСЯ, и почему это ВЕРХНЯЯ ГРАНИЦА, а не вердикт:
    # совпадением считается дословное окно из шести слов (шаг 3, нормировка —
    # нижний регистр, всё кроме букв и цифр в пробел). Урок, пересказанный в
    # навыке ДРУГИМИ словами, здесь будет выглядеть сиротой. При ручной
    # проверке 2026-09-13 из одиннадцати нулей четыре оказались изложены в
    # queen-swarm-unblock другими словами — то есть список надо дочитывать
    # глазами, а не считать приговором.
    #   tri lesson-orphans [--all]   (--all: + ~/skills и ~/.claude/skills)
    # Выход 2 = найдены сироты. Это ответ, а не сбой.
    shift 2>/dev/null || true
    python3 - "$@" << 'PYORPHAN'
import json, os, re, sys

STATE = "/Users/playra/BrowserOS/trios/.trinity/loop/state.json"
ROOTS = ["/Users/playra/BrowserOS/trios/.claude/skills"]
if "--all" in sys.argv[1:]:
    ROOTS += [os.path.expanduser("~/skills"), os.path.expanduser("~/.claude/skills")]

WORD = re.compile(r"[^a-z0-9]+")
N, STEP = 6, 3


def shingles(text, step=STEP):
    w = [x for x in WORD.sub(" ", text.lower()).split() if x]
    return [" ".join(w[i:i + N]) for i in range(0, max(0, len(w) - N + 1), step)]


try:
    state = json.load(open(STATE, encoding="utf-8"))
except Exception as e:
    sys.exit("state.json не читается: %s" % e)
lessons = state.get("lessons") or []
if not lessons:
    sys.exit("в state.json нет уроков — тогда и сирот быть не может")

# Корпус навыков: КАЖДОЕ окно из шести слов, шагом 1, иначе выравнивание окон
# решало бы за содержание.
corpus, files = {}, []
for root in ROOTS:
    if not os.path.isdir(root):
        print("нет каталога: %s" % root)
        continue
    for dirpath, _dirs, names in os.walk(root):
        for n in names:
            if not n.endswith(".md"):
                continue
            p = os.path.join(dirpath, n)
            files.append(p)
            try:
                body = open(p, encoding="utf-8", errors="replace").read()
            except Exception:
                continue
            for sh in shingles(body, step=1):
                corpus.setdefault(sh, p)

orphans = []
rows = []
for i, les in enumerate(lessons, 1):
    text = (les.get("text") or "").strip()
    sh = shingles(text)
    if not sh:
        continue
    hits = [corpus[s] for s in sh if s in corpus]
    score = len(hits) / len(sh)
    best = max(set(hits), key=hits.count) if hits else None
    rows.append((i, les.get("iteration"), score, best, text))
    if not hits:
        orphans.append((i, les.get("iteration"), text))

print("уроков в state.json     : %d" % len(lessons))
print("файлов навыков прочитано: %d" % len(files))
for r in ROOTS:
    print("  корень: %s" % r)
print("ни одного общего окна   : %d" % len(orphans))
print()
for i, it, text in orphans:
    print("  L%-3d итерация %-4s %s" % (i, it, text[:96].replace("\n", " ")))
if rows:
    rows.sort(key=lambda r: r[2])
    print("\nближайшие к нулю, но не нулевые (для калибровки порога):")
    for i, it, score, best, text in [r for r in rows if r[2] > 0][:5]:
        print("  L%-3d %.2f  %s" % (i, score, os.path.basename(os.path.dirname(best or "")) or "?"))
print(
    "\nЭто ВЕРХНЯЯ ГРАНИЦА: совпадение здесь дословное (окно из шести слов),"
    "\nа урок можно изложить в навыке другими словами. Список дочитывают глазами."
)
sys.exit(2 if orphans else 0)
PYORPHAN
    ;;
  wave-plan)
    # План ТЕКУЩЕЙ волны целиком — самый свежий trios/.trinity/wave-loop-*.md.
    # `tri wave` заводит СЛЕДУЮЩУЮ пустую волну, `tri next` печатает только
    # хвост с вариантами, `tri handover` — сводку владельцу из той же волны.
    # Здесь файл целиком, и первой строкой его возраст с файловой системы.
    #   tri wave-plan [N]   (N — только первые N строк)
    T=/Users/playra/BrowserOS/trios
    w=$(ls "$T/.trinity"/wave-loop-*.md 2>/dev/null | sort | tail -1)
    [ -z "$w" ] && { echo "нет ни одной волны в $T/.trinity/wave-loop-*.md"; exit 1; }
    total=$(ls "$T/.trinity"/wave-loop-*.md 2>/dev/null | wc -l | tr -d ' ')
    age=$(( ( $(date +%s) - $(stat -f %m "$w") ) / 3600 ))
    echo "$w  (записан ${age} ч назад; волн на диске: $total, строк: $(wc -l < "$w" | tr -d ' '))"
    echo
    # Без вложенного `case`: его метки попадали бы в любой перебор меток этого
    # файла (`grep '^\s*[a-z0-9-]*)'`) и завели бы команду `0`, которой нет.
    N="${2:-}"
    if [ -z "$N" ]; then
      cat "$w"
    elif [ "$N" -ge 1 ] 2>/dev/null; then
      sed -n "1,${N}p" "$w"
    else
      echo "tri wave-plan [N] — N это число строк"; exit 1
    fi
    ;;


