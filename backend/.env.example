# TRIOS Backend Environment Variables

# PostgreSQL Database URL (Neon, Railway, or local)
DATABASE_URL=postgresql://user:pass@localhost:5432/trios

# Server port
PORT=3000

# Example Neon URL:
# DATABASE_URL=postgresql://trios_user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/trios?sslmode=require

# Example Railway URL:
# DATABASE_URL=postgresql://postgres:password@containers.railway.app:5432/postgres
