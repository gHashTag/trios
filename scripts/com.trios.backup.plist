<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trios.backup</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Users/playra/trios/scripts/auto-backup.sh</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/playra/trios</string>
    
    <key>StartInterval</key>
    <integer>3600</integer> <!-- Run every hour -->
    
    <key>StandardOutPath</key>
    <string>/Users/playra/trios/.trios/run/backup.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/playra/trios/.trios/run/backup.err</string>
    
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
