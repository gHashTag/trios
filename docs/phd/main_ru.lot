\contentsline {table}{\numberline {41}{\ignorespaces GF4: 8 positive values + sign. Range [−6.854, 6.854]. Zero-point-free.\relax }}{414}{table.caption.516}%
\contentsline {table}{\numberline {42}{\ignorespaces GF8: 4-bit exponent, 3-bit mantissa (ternary encoded), 1-bit sign. Total: 256 encodings. Zero and NaN reserved.\relax }}{415}{table.caption.518}%
