# PhD Monograph build — Single SSOT Edition
# After 2026-05-15 unification: ONLY source-of-truth is Postgres ssot.chapters + ssot.assets
# All .tex/.pdf are GENERATED by phd-md2pdf Rust pipeline.
#
# Usage:
#   make pdf      — regenerate from Postgres SSOT
#   make clean    — remove generated build artefacts
#
# Required env:
#   DATABASE_URL=postgresql://.../railway  (phd-postgres-ssot)

PIPELINE_ROOT ?= $(HOME)/workspace/phd-md2pdf
BUILD_DIR     ?= /tmp/phd-md-build
OUT_DIR       ?= $(CURDIR)/out
REPO_ROOT     ?= $(abspath $(CURDIR)/../..)

.PHONY: pdf clean check-env

pdf: check-env
	cd $(PIPELINE_ROOT) && cargo build --release --bin phd-build-from-md --bin phd-remarkdown
	cd $(PIPELINE_ROOT) && DATABASE_URL="$$DATABASE_URL" ./target/release/phd-remarkdown
	cd $(PIPELINE_ROOT) && DATABASE_URL="$$DATABASE_URL" ./target/release/phd-build-from-md \
		--build-dir $(BUILD_DIR) \
		--out-dir   $(OUT_DIR) \
		--repo-root $(REPO_ROOT)
	@echo "OK: PDF generated at $(OUT_DIR)/main.pdf"
	@du -h $(OUT_DIR)/main.pdf || true

check-env:
	@test -n "$$DATABASE_URL" || (echo "ERROR: DATABASE_URL not set (need phd-postgres-ssot URL)"; exit 1)

clean:
	rm -rf $(BUILD_DIR) $(OUT_DIR)
